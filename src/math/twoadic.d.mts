export type Valuation = {kind:'finite';exponent:number}|{kind:'infinite'};
export type Size = {kind:'zero'}|{kind:'pow2';exponent:number};
export type Carry = {width:number;cursor:number;visible:bigint;pending:bigint;done:boolean};
export function parseInteger(raw:string,maxDigits?:number):bigint;
export function pow2(k:number):bigint;
export function v2(n:bigint):Valuation;
export function norm2(n:bigint):Size;
export function distance2(a:bigint,b:bigint):Size;
export function compareSizes(a:Size,b:Size):number;
export function formatSize(s:Size):string;
export function residue(n:bigint,k:number):bigint;
export function bits(n:bigint,k:number):string;
export function path(n:bigint,depth:number):Array<{depth:number;residue:bigint;modulus:bigint;bit:number|null}>;
export function sharedDepth(a:bigint,b:bigint):Valuation;
export function ballExamples(r:bigint,k:number):bigint[];
export function valuationSteps(n:bigint):bigint[];
export function sequence(n:number):{n:number;sum:bigint;plusOne:bigint;ordinaryError:bigint;twoAdicError:Size};
export function gcd(a:bigint,b:bigint):bigint;
export function rational(p:bigint,q:bigint):{p:bigint;q:bigint};
export function rationalNorm(p:bigint,q:bigint):Size;
export function expandFraction(p:bigint,q:bigint,k:number):{p:bigint;q:bigint;k:number;modulus:bigint;residue:bigint;bits:string;verification:bigint;target:bigint};
export function rootLevels(a:bigint,maxDepth:number):Array<{depth:number;modulus:bigint;roots:bigint[]}>;
export function createCarry(width?:number):Carry;
export function stepCarry(s:Carry):Carry;
